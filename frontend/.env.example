# Endereços públicos dos serviços do backend, sem barra no fim. Obrigatórios:
# o build falha sem eles, e o código não tem endereço padrão.
# Na Vercel: Settings, Environment Variables (Production e Preview).
# No computador: copie para frontend/.env. Os valores abaixo são do backend local.
# O app usa sempre VITE_API_BASE_URL; o api_url que o login devolve fica de reserva.
VITE_AUTH_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000
