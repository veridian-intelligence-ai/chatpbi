# ─────────────────────────────────────────────
# Variáveis do backend: serviço api (api/main.py) e serviço auth (auth_server.py).
# Copie para .env (api) e auth.env (auth) em desenvolvimento e preencha.
# Em produção ficam nas variáveis de cada serviço no Railway.
# Nenhum valor entra no Git.
# ─────────────────────────────────────────────

# --- Comuns aos dois serviços ---
# URL do Postgres (no Railway: ${{Postgres.DATABASE_URL}}).
DATABASE_URL=
# Origens do frontend autorizadas pelo CORS, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:8080
# Pool de conexões (opcional). A soma dos dois serviços tem de caber no limite
# de conexões do Postgres. Defaults: min 1, max 10, espera de 10 s.
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10

# --- Serviço api ---
# Claude: chave da API e modelos do chat e da voz.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VOICE_MODEL=claude-haiku-5-5
# Opcionais: tecto de tokens por chamada e timeout por chamada (s).
# ANTHROPIC_MAX_TOKENS=12000
# ANTHROPIC_VOICE_MAX_TOKENS=4096
# ANTHROPIC_TIMEOUT_SECONDS=180

# Voz ao vivo (OpenAI Realtime, WebRTC no browser). Com a chave definida, o
# modo de voz usa a OpenAI; o backend só entrega ao browser uma chave efémera.
OPENAI_API_KEY=
# Opcionais: modelo de voz, voz e modelo de transcrição.
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Voz clássica (opcional): gravação + ElevenLabs STT/TTS. Só é usada sem a
# OPENAI_API_KEY.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Power BI: service principal do Entra ID (client credentials) e o modelo.
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=
FABRIC_DEFAULT_DATASET_ID=
# Pacote do modelo em api/semantic_models/ (contexto, regras, sugestões).
SEMANTIC_MODEL=cota_parlamentar
# Opcional: nome com que o assistente se apresenta no chat e na voz.
# ASSISTANT_NAME=ChatPBI

# Canal do WhatsApp (opcional, WhatsApp Cloud API da Meta). Liga só com as
# quatro primeiras. Passo a passo na skill .claude/skills/whatsapp.
# Token de acesso do WhatsApp e chave secreta do App da Meta (segredos).
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Identificação do número de telefone e o texto de verificação do webhook.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Números autorizados: numero=email (usuário ativo do app), separados por vírgula.
# Número com código do país, só dígitos. Ex.: 351912345678=ana@empresa.com
WHATSAPP_ALLOWED_NUMBERS=
# Opcionais: modelo do Claude do canal (padrão ANTHROPIC_MODEL) e versão da Graph API.
# WHATSAPP_MODEL=claude-sonnet-5-5
# Voz da resposta em áudio: openai (padrão, usa a OPENAI_API_KEY) ou elevenlabs.
# WHATSAPP_TTS_PROVIDER=openai
# WHATSAPP_TTS_VOICE=coral
# WHATSAPP_TTS_MODEL=gpt-4o-mini-tts
# WHATSAPP_GRAPH_VERSION=v25.0

# --- Serviço auth ---
# Opcional: chave dos endpoints /admin/* (cabeçalho X-Admin-Key), senha longa
# e aleatória. Sem ela, os endpoints /admin/* ficam desligados.
AUTH_SECRET_KEY=
# Validade da sessão, em horas (opcional, default 24).
# AUTH_TOKEN_EXPIRE_HOURS=24
# Opcional: endereço público do serviço api, devolvido no login. O frontend
# usa primeiro o VITE_API_BASE_URL. Nome antigo, ainda aceito: VERIDIAN_API_URL.
# API_PUBLIC_URL=
# WorkOS (User Management): API key e Client ID do ambiente.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Login pela página do AuthKit (opcional): endereço /callback do frontend.
# WORKOS_REDIRECT_URI=
# Porta do serviço auth no Railway (o domínio aponta para ela).
# PORT=8080
# Cliente e admin criados no primeiro arranque (instalação nova).
SEED_CLIENT_SLUG=
SEED_CLIENT_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
